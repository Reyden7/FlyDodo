# Remplacez les identifiants de test par les blocs publicitaires Android de FlyDodo.
# L'identifiant d'application se remplace dans android/app/src/main/res/values/strings.xml.
VITE_ADMOB_ANDROID_INTERSTITIAL_ID=ca-app-pub-XXXXXXXXXXXXXXXX/XXXXXXXXXX
VITE_ADMOB_ANDROID_REWARDED_ID=ca-app-pub-XXXXXXXXXXXXXXXX/XXXXXXXXXX

# Clé publique Android du projet RevenueCat (commence généralement par goog_).
VITE_REVENUECAT_ANDROID_API_KEY=goog_XXXXXXXXXXXXXXXXXXXXXXXX
